{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Dataset Prepare",
            "type": "debugpy",
            "request": "launch",
            "module": "nanochat.dataset",
            "args": ["-n", "8"],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "2. Tokenizer Train",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.tok_train",
            "args": ["--max-chars", "2000000000"],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "3. Tokenizer Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.tok_eval",
            "args": [],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "4. Base Train (MPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.base_train",
            "args": [
                "--device-type=mps",
                "--depth=6",
                "--head-dim=64",
                "--window-pattern=L",
                "--max-seq-len=512",
                "--device-batch-size=16",
                "--total-batch-size=16384",
                "--eval-every=100",
                "--eval-tokens=524288",
                "--core-metric-every=-1",
                "--sample-every=100",
                "--num-iterations=5000",
                "--run=dummy"
            ],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat",
                "TORCH_COMPILE_DISABLE": "1"
            }
        },
        {
            "name": "5. Base Eval (MPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.base_eval",
            "args": [
                "--device-type=mps",
                "--device-batch-size=1",
                "--split-tokens=16384",
                "--max-per-task=16"
            ],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "6. Chat SFT (MPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.chat_sft",
            "args": [
                "--device-type=mps",
                "--max-seq-len=512",
                "--device-batch-size=16",
                "--total-batch-size=16384",
                "--eval-every=200",
                "--eval-tokens=524288",
                "--num-iterations=1500",
                "--run=dummy"
            ],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "7. Chat CLI (MPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.chat_cli",
            "args": [
                "--device-type=mps",
                "-p", "What is the capital of France?"
            ],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "8. Chat Web (MPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.chat_web",
            "args": ["--device-type=mps"],
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        },
        {
            "name": "Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "NANOCHAT_BASE_DIR": "${env:HOME}/.cache/nanochat"
            }
        }
    ]
}
